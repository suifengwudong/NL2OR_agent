  "_comment": "NL2OR benchmark cases. input_ir = 脏 IR（LLM 原始输出，含别名）；expected = 归一化后应得结果；solver_objective = 参考最优目标值（由 benchmarks/references/solve_references.py 计算）。",
  "cases": [
    {
      "id": "p_median_community",
      "name": "P-Median 社区服务中心",
      "problem": "某街道计划在 5 个候选位置 A、B、C、D、E 中开设 3 个社区服务中心。6 个居民区的人口分别为 80、120、100、90、110、70。各居民区到各候选位置的距离矩阵为 [[4,6,9,7,8],[5,3,8,6,7],[9,7,4,5,6],[8,6,5,3,4],[6,5,7,4,3],[7,8,6,5,4]]。每个居民区必须且只能分配到一个服务中心，只有开设的服务中心才能接收分配，恰好开设 3 个。目标是最小化所有居民区到其服务中心的需求加权总距离。",
      "input_ir": {
        "problem_families": [{"id": "p-median", "confidence": 0.9}],
        "parameters": {"p": 3},
        "constraint_blocks": [
          {"block_id": "assignment", "parameters": {}, "status": "required"},
          {"block_id": "linking", "parameters": {}, "status": "required"},
          {"block_id": "cardinality", "parameters": {"p": 3}, "status": "required"}
        ],
        "objective": "minimize_total_weighted_distance"
      },
      "expected": {
        "families": ["p_median"],
        "block_ids": ["assign_each_demand_once", "link_assignment_to_open", "cardinality_open_p_facilities"],
        "objective_block": "weighted_service_distance_objective"
      },
      "solver_objective": 2210.0
    },
    {
      "id": "set_covering_emergency",
