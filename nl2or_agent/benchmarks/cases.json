          {"block_id": "max_covering_constraint", "parameters": {"coverage_matrix": "由覆盖矩阵给定"}, "status": "required"},
          {"block_id": "cardinality", "parameters": {"p": 2}, "status": "required"}
        ],
        "objective": {"block_id": "covered_demand_objective"}
      },
      "expected": {
        "families": ["maximum_covering"],
