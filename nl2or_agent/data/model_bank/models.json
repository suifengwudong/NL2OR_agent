{
  "models": [
    {
      "id": "location_problem",
      "is_family": true,
      "name": "选址问题族",
      "description": "所有选址变体的公共骨架：决定开设哪些设施以服务需求点。",
      "base_blocks": [
        "assign_each_demand_once",
        "link_assignment_to_open"
      ],
      "optional_blocks": [
        "force_facility_open",
        "force_facility_closed"
      ],
      "decision_variables": [
        {
          "symbol": "y_j",
          "type": "binary",
          "meaning": "是否在候选点 j 开设设施"
        },
        {
          "symbol": "x_ij",
          "type": "binary",
          "meaning": "需求点 i 分配给设施 j"
        }
      ],
      "keywords": [
        "选址",
        "location",
        "facility",
        "设施"
      ]
    },
    {
      "id": "p_median",
      "family": "location_problem",
      "name": "P-Median 选址",
      "description": "正好开设 p 个设施，最小化加权距离和。",
      "blocks": [
        "cardinality_open_p_facilities"
      ],
      "objective_block": "weighted_service_distance_objective",
      "parameters": [
        {
          "name": "p",
          "type": "integer",
          "required": true
        },
        {
          "name": "distance",
          "type": "dict",
          "required": true
        },
        {
          "name": "weight",
          "type": "dict",
          "required": false
        }
      ],
      "keywords": [
        "P-Median",
        "p-median",
        "p中位",
        "加权距离"
      ]
    },
    {
      "id": "facility_location",
      "family": "location_problem",
      "name": "无容量设施选址",
      "description": "固定成本+服务成本最小化。",
      "objective": "min sum(f_j * y_j) + sum(c_ij * x_ij)",
      "parameters": [
        {
          "name": "fixed_cost",
          "type": "dict",
          "required": true
        },
        {
          "name": "service_cost",
          "type": "dict",
          "required": true
        }
      ],
      "keywords": [
        "选址",
        "facility location",
        "固定成本"
      ]
    },
    {
